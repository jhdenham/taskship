---
// Self-hosted variable fonts: one file per family covers every weight, and
// browsers fetch only the character sets a page uses.
import '@fontsource-variable/manrope';
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/jetbrains-mono';
import manropeLatin from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import spaceGroteskLatin from '@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url';
import jetbrainsMonoLatin from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';
import '../styles/global.css';
import GitHubIcon from '../components/GitHubIcon.astro';

interface Props {
  title: string;
  description?: string;
  /** Show the early-development bar above the header. */
  status?: boolean;
}

const {
  title,
  description = 'Taskship is a local-first task manager and agent dispatcher for developers.',
  status = false,
} = Astro.props;
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {
      [manropeLatin, spaceGroteskLatin, jetbrainsMonoLatin].map((href) => (
        <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
      ))
    }
    <script is:inline>
      // Apply a saved theme before the page paints. Without one, the system
      // setting decides.
      try {
        const theme = localStorage.getItem('theme');
        if (theme) document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
  </head>
  <body>
    {
      status && (
        <div class="statusbar">
          <p>
            <span class="badge">Early</span>
            <span>
              Taskship is in early development. Setup, tasks with labels and comments, the TUI,
              and launching Claude Code work today.
            </span>
            <a href="/docs/roadmap/">See the roadmap →</a>
          </p>
        </div>
      )
    }
    <header class="topbar">
      <div class="topbar-inner">
        <a class="brand" href="/">
          <svg class="brand-mark" width="30" height="30" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M2.5 14.5h19l-3 5h-13z"></path>
            <rect x="5" y="10" width="4.5" height="4.5" rx="0.6"></rect>
            <rect x="9.5" y="5.5" width="4.5" height="4.5" rx="0.6"></rect>
            <rect x="9.5" y="10" width="4.5" height="4.5" rx="0.6"></rect>
            <path d="M16.5 14.5V8h2.5v6.5"></path>
          </svg>
          taskship
        </a>
        <nav class="toplinks" aria-label="Main">
          <a class="hide-sm" href="/#how">How it works</a>
          <a class="docslink" href="/docs/" aria-current={path.startsWith('/docs/') ? 'page' : undefined}>Docs</a>
          <a class="iconlink github" href="https://github.com/jhdenham/taskship" aria-label="Taskship on GitHub" title="GitHub">
            <GitHubIcon />
          </a>
          <button class="theme iconlink" type="button" aria-label="Switch between light and dark" title="Switch between light and dark">
            <svg class="sun" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
            </svg>
            <svg class="moon" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
          </button>
          <a class="btn primary small" href="/docs/quickstart/">Get started</a>
        </nav>
      </div>
    </header>
    <slot />
    <footer class="footer">
      <div class="footer-inner">
        <span>Taskship · Apache License 2.0</span>
        <a href="https://github.com/jhdenham/taskship">github.com/jhdenham/taskship</a>
      </div>
    </footer>
    <script>
      const root = document.documentElement;
      document.querySelector('.theme')!.addEventListener('click', () => {
        const dark =
          root.dataset.theme === 'dark' ||
          (!root.dataset.theme && matchMedia('(prefers-color-scheme: dark)').matches);
        root.dataset.theme = dark ? 'light' : 'dark';
        try {
          localStorage.setItem('theme', root.dataset.theme);
        } catch {}
      });
    </script>
  </body>
</html>
